DATABASE_URL="postgresql://postgres:postgres@localhost:5432/my_project_database?schema=public"
SHADOW_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/my_project_database_shadow?schema=public"

API_PORT=3001
FRONTEND_ORIGIN=http://localhost:3000
FRONTEND_ORIGINS=http://localhost:3000,https://nearloy.up.railway.app,https://nearloy.ru,https://www.nearloy.ru
# Used by the Nest API to sign and verify JWT access tokens.
JWT_SECRET="replace-with-a-long-random-secret-min-32-chars"
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_DAYS=7

NEXT_PUBLIC_API_URL=http://localhost:3001/api
NEXT_PUBLIC_YANDEX_MAPS_API_KEY=
NEXT_PUBLIC_YANDEX_METRIKA_ID=111014909
YANDEX_GEOCODER_API_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Custom URL scheme registered by the native NearLoy app for OAuth handoff, for example nearloy://oauth/vkid/complete.
NEARLOY_MOBILE_APP_SCHEME=nearloy

# Nearloy Hunt.
# Railway: set HUNT_SEED_ON_START=true on exactly one service for the first deploy, usually the API service.
# Keep HUNT_SEED_DEMO_DATA=false or unset in production unless you intentionally need demo posts/users.
NEXT_PUBLIC_HUNT_ENABLED=true
HUNT_SEED_ON_START=false
HUNT_SEED_DEMO_DATA=false
HUNT_MEDIA_DIR=

# Yandex Advertising Network. Leave disabled until the site passes moderation and block ids are issued.
NEXT_PUBLIC_YANDEX_RSYA_ENABLED=false
NEXT_PUBLIC_YANDEX_RSYA_HUNT_FEED_BLOCK_ID=

# OpenAI company assistant. API key is used only by the Nest API, never by the browser.
# gpt-5.4-nano keeps company helper responses cheap; override if quality is not enough.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.4-nano
OPENAI_COMPANY_ASSISTANT_MAX_OUTPUT_TOKENS=900
# Optional: use a deployed API gateway for local development when direct OpenAI access is unavailable.
# Production API service should have AI_GATEWAY_SECRET and OPENAI_API_KEY.
# Local API/web services should use OPENAI_GATEWAY_URL + OPENAI_GATEWAY_SECRET.
AI_GATEWAY_SECRET=
OPENAI_GATEWAY_URL=
OPENAI_GATEWAY_SECRET=

# First public release toggle. Keep disabled until subscription flows are ready for users.
NEXT_PUBLIC_SUBSCRIPTIONS_ENABLED=false
SUBSCRIPTIONS_ENABLED=false

# Telegram Bot API integration. Operational admin notifications go to the shared chat below.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=nearloy_bot
TELEGRAM_DEV_BOT_TOKEN=
TELEGRAM_DEV_BOT_USERNAME=White_Box_Loyalty_dev_bot

TELEGRAM_ADMIN_CHAT_ID=3977200071
# Public HTTPS origin for Telegram bot Web App buttons. Bot menu opens /app from this origin.
TELEGRAM_WEB_APP_URL=https://nearloy.ru/
TELEGRAM_DEV_WEB_APP_URL=https://nearloy.ru/
# Max accepted age for Telegram Mini App initData during passwordless login.
TELEGRAM_MINI_APP_AUTH_MAX_AGE_SECONDS=86400
# Optional local proxy for Telegram Bot API, for example http://127.0.0.1:10809
TELEGRAM_PROXY_URL=
# Public HTTPS endpoint for button callbacks, for example https://whitebox.app/api/telegram/webhook
TELEGRAM_WEBHOOK_URL=
# Local dev endpoint used by npm run telegram:poll:local.
TELEGRAM_LOCAL_BOT=dev
TELEGRAM_LOCAL_WEBHOOK_URL=http://localhost:3000/api/telegram/webhook?bot=dev
# Local polling safe mode. Keep enabled to avoid reading/responding to group chats
# or random comments while developing with a dev bot.
TELEGRAM_LOCAL_POLL_PRIVATE_ONLY=true
TELEGRAM_LOCAL_POLL_COMMANDS_ONLY=true
# Optional secret header checked by /api/telegram/webhook.
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_DEV_WEBHOOK_SECRET=

# MAX Bot API integration. Mini-app URL in MAX cabinet: https://nearloy.ru/max
MAX_BOT_TOKEN=
MAX_WEBHOOK_URL=https://nearloy.ru/api/max/webhook
MAX_WEBHOOK_SECRET=
MAX_API_BASE_URL=https://platform-api2.max.ru
# MAX currently may serve a certificate chain that Node/Railway does not trust.
# Keep this scoped flag for MAX API calls only; do not use NODE_TLS_REJECT_UNAUTHORIZED globally.
MAX_TLS_REJECT_UNAUTHORIZED=false
MAX_MINI_APP_AUTH_MAX_AGE_SECONDS=86400
# Optional secret for /api/admin/reports/daily GET preview and POST delivery.
DAILY_REPORT_SECRET=
# Daily Telegram report scheduler. 23:00 MSK is 20:00 UTC; keep enabled for the web service.
DAILY_REPORT_SCHEDULER_ENABLED=true
DAILY_REPORT_TIME_MSK=23:00
# Optional override. By default the scheduler calls the local Next.js web service.
DAILY_REPORT_BASE_URL=
DAILY_REPORT_RETRY_ATTEMPTS=3
# Optional: dev/prod. Defaults to prod in NODE_ENV=production and dev locally.
DAILY_REPORT_BOT=

# Temporary encrypted storage for company verification passport photos.
# Keep this secret stable: changing it makes existing encrypted files unreadable.
# If empty, the app falls back to JWT_SECRET in local/dev environments.
PASSPORT_STORAGE_SECRET="replace-with-a-long-random-secret-min-32-chars"
PASSPORT_STORAGE_DIR="storage/private/passport-verifications"

# Encrypted YooKassa saved payment method ids for company recurring payments.
# If empty, the API falls back to PASSPORT_STORAGE_SECRET/JWT_SECRET in local/dev.
PAYMENT_METHOD_ENCRYPTION_KEY="replace-with-a-long-random-secret-min-32-chars"

# YooKassa payment acceptance. Keep the secret key only in env/secrets.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_RETURN_URL=http://localhost:3000/payment/success
YOOKASSA_COMPANY_RETURN_URL=http://localhost:3000/company/billing
# VAT code used in YooKassa receipt items. 1 = without VAT.
YOOKASSA_VAT_CODE=1
# Maximum bank-card checkout/subscription price in RUB.
YOOKASSA_MAX_BANK_CARD_PAYMENT_RUB=349999
# YooKassa payouts. Use payout gateway credentials; shop credentials are only a dev fallback.
YOOKASSA_PAYOUT_API_URL=https://api.yookassa.ru/v3
YOOKASSA_PAYOUT_AGENT_ID=516729
YOOKASSA_PAYOUT_SECRET_KEY=
# Raw card payout data is for YooKassa test gateway only. Do not enable for production cards.
YOOKASSA_PAYOUT_ALLOW_RAW_CARD=false
# Background reconciliation catches YooKassa payments when webhook/return redirects are missed.
# Set interval to 0 to disable the worker.
PAYMENT_RECONCILIATION_INTERVAL_MS=60000
PAYMENT_RECONCILIATION_LOOKBACK_HOURS=24
PAYMENT_RECONCILIATION_BATCH_SIZE=50

# Email delivery.
# EMAIL_PROVIDER=auto tries configured HTTP providers first, then SMTP. Use `resend`, `smtp`, `resend,smtp`, or `dev-outbox` for explicit modes.
EMAIL_PROVIDER=auto
MAIL_FROM="NearLoy <no-reply@nearloy.local>"
RESEND_API_KEY=
RESEND_API_URL=https://api.resend.com/emails

# SMTP fallback/local delivery. Railway Hobby does not allow outbound SMTP; use an HTTP provider in production.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Optional smart email routing.
# Russian recipient domains (yandex.ru, mail.ru, bk.ru, etc.) use YANDEX_SMTP_* when configured.
# Gmail/international recipient domains use GOOGLE_SMTP_* when configured.
GOOGLE_SMTP_HOST=smtp.gmail.com
GOOGLE_SMTP_PORT=465
GOOGLE_SMTP_SECURE=true
GOOGLE_SMTP_USER=
GOOGLE_SMTP_PASS=
GOOGLE_SMTP_FROM=
YANDEX_SMTP_HOST=smtp.yandex.ru
YANDEX_SMTP_PORT=465
YANDEX_SMTP_SECURE=true
YANDEX_SMTP_USER=
YANDEX_SMTP_PASS=
YANDEX_SMTP_FROM=

REGISTRATION_EMAIL_CODE_TTL_MINUTES=15
PASSWORD_RESET_EMAIL_CODE_TTL_MINUTES=15
EMAIL_VERIFICATION_CODE_RETENTION_HOURS=24
EMAIL_CHANGE_TOKEN_HOURS=24
