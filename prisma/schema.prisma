// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELED
}

/// Application role: client app users are CLIENT; company portals & admin consoles use COMPANY / admin roles.
enum UserRole {
  CLIENT
  COMPANY
  ADMIN
  SUPER_ADMIN
  MANAGER
  SUPPORT
}

enum AccountStatus {
  ACTIVE
  FROZEN_PENDING_DELETION
  BLOCKED
}

enum ProfileStatusRarity {
  RARE
  EPIC
  LEGENDARY
}

enum LoyaltyTransactionType {
  EARN
  SPEND
}

enum LoyaltyTransactionStatus {
  ACTIVE
  EXPIRED
}

enum SubscriptionSpendPolicy {
  EXCLUDE
  INCLUDE_NO_BONUS
  INCLUDE_WITH_BONUS
}

enum CompanyMemberRole {
  OWNER
  MANAGER
  CASHIER
}

enum CompanyMediaKind {
  LOGO
  HERO
  GALLERY
}

enum CompanySocialLinkKind {
  WEBSITE
  VK
  MAX
  OTHER
}

enum SubscriptionEntitlementWindow {
  DAY
  WEEK
  MONTH
  TERM
  UNLIMITED
}

enum AuditWorkspace {
  MANAGER
  DEVELOPER
}

enum AuditLevel {
  INFO
  WARN
  CRITICAL
}

enum AuditCategory {
  SECURITY
  USER
  SUBSCRIPTION
  BILLING
  SYSTEM
}

enum AuditResult {
  SUCCESS
  BLOCKED
}

enum AdminTaskSource {
  AUDIT
  COMPANY_VERIFICATION
  FINANCE
}

enum AdminTaskPriority {
  NORMAL
  HIGH
  CRITICAL
}

enum AdminTaskStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  DISMISSED
}

enum LandingLeadStatus {
  NEW
  IN_PROGRESS
  CLOSED
  SPAM
}

enum NotificationDeliveryStatus {
  PENDING
  SENT
  FAILED
}

enum CompanyEmploymentType {
  SELF_EMPLOYED
  INDIVIDUAL_ENTREPRENEUR
}

enum CompanyVerificationStatus {
  DRAFT
  SUBMITTED
  REVIEWING
  APPROVED
  REJECTED
}

enum IdentityVerificationMode {
  FULL
  DEFERRED
}

enum PassportFileStatus {
  ACTIVE
  DELETED
  MISSING
}

enum CompanyKycAccessAction {
  UPSERT_FROM_VERIFICATION
  REVEAL_DATA
  VIEW_PHOTO
  DELETE_PHOTO
}

enum PromoCodeRewardType {
  POINTS
  SUBSCRIPTION
}

enum SubscriptionBundleStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum SubscriptionBundleParticipantStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ReferralInviteStatus {
  CREATED
  REDEEMED
  REWARDED
}

enum CompanyReferralStatus {
  ACTIVE
  PAUSED
  ENDED
}

enum CompanyReferralPipelineStatus {
  LEAD
  NEGOTIATION
  TRIAL
  CONNECTED
  REVENUE_ACTIVE
  LOST
}

enum PermissionScope {
  USERS
  COMPANIES
  COMPANY_VERIFICATIONS
  PR
  FINANCE
  SUPPORT
  AUDIT
  DATABASE
  TELEGRAM
  PROMOTION
  HUNT
  SETTINGS
}

enum FinanceOperationType {
  PAYOUT_REQUEST
  PAYOUT_APPROVAL
  MANUAL_ADJUSTMENT
  REFUND
}

enum FinanceOperationStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  PAID
  CANCELED
}

enum CompanyBillingStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  SUSPENDED
}

enum CompanyBillingInvoiceStatus {
  OPEN
  PAID
  WAIVED
  CANCELED
}

enum PaymentProvider {
