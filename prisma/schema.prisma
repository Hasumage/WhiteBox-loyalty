  linkLabel    String?
  createdAt    DateTime       @default(now())

  actorUser  User? @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  targetUser User? @relation("AuditTarget", fields: [targetUserId], references: [id], onDelete: SetNull)

  @@index([workspace, createdAt])
  @@index([category, createdAt])
  @@index([level, createdAt])
  @@index([targetUserId, createdAt])
  @@index([targetEmail])
  @@index([targetUuid])
}

model AdminTask {
  id           String            @id @default(cuid())
  uuid         String            @unique @default(uuid())
  source       AdminTaskSource
  sourceKey    String            @unique
  title        String
  description  String?           @db.Text
  priority     AdminTaskPriority @default(NORMAL)
  status       AdminTaskStatus   @default(OPEN)
  targetUrl    String?
  targetLabel  String?
  assignedToId Int?
  resolvedById Int?
  assignedAt   DateTime?
  resolvedAt   DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  assignedTo User? @relation("AdminTaskAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  resolvedBy User? @relation("AdminTaskResolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([status, priority, createdAt])
  @@index([source, status, createdAt])
  @@index([assignedToId, status])
}

model LandingLead {
  id          Int               @id @default(autoincrement())
  uuid        String            @unique @default(uuid())
  name        String
  company     String?
  contact     String
  business    String?
  message     String            @db.Text
  status      LandingLeadStatus @default(NEW)
  source      String            @default("landing")
  ipAddress   String?
  userAgent   String?
  fingerprint String
  spamScore   Int               @default(0)
  notes       String?           @db.Text
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  processedAt DateTime?

  deliveries NotificationDelivery[]

  @@index([status, createdAt])
  @@index([contact])
  @@index([fingerprint, createdAt])
}

model NotificationDelivery {
  id                String                     @id @default(cuid())
  leadId            Int
  channel           String                     @default("telegram")
  recipientRole     String
  recipientChatId   String
  recipientLabel    String?
  status            NotificationDeliveryStatus @default(PENDING)
  attempts          Int                        @default(0)
  telegramMessageId Int?
  lastError         String?                    @db.Text
  nextRetryAt       DateTime?
  sentAt            DateTime?
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt

  lead LandingLead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([status, nextRetryAt])
  @@index([recipientRole, createdAt])
}

model TelegramMessageQueue {
  id                String                     @id @default(cuid())
  recipientChatId   String
  recipientRole     String?
  recipientLabel    String?
  text              String                     @db.Text
  parseMode         String?
  replyMarkup       Json?
  status            NotificationDeliveryStatus @default(PENDING)
  attempts          Int                        @default(0)
  telegramMessageId Int?
  lastError         String?                    @db.Text
  nextRetryAt       DateTime?
  sentAt            DateTime?
  source            String?
  sourceId          String?
  priority          Int                        @default(0)
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt

  @@index([status, nextRetryAt])
  @@index([source, sourceId])
  @@index([recipientChatId, createdAt])
}

model HuntPlayerProfile {
  id                  String    @id @default(cuid())
  userId              Int       @unique
  influenceBalance    Int       @default(0)
  lifetimeInfluence   Int       @default(0)
  xp                  Int       @default(0)
  level               Int       @default(1)
  postsCount          Int       @default(0)
  likesReceivedCount  Int       @default(0)
  boxesOpenedCount    Int       @default(0)
  cardsOwnedCount     Int       @default(0)
  tutorialCompletedAt DateTime?
  lastDailyBoxAt      DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([level, xp])
  @@index([lifetimeInfluence])
}

model HuntPlace {
  id               String               @id @default(cuid())
  uuid             String               @unique @default(uuid())
  slug             String               @unique
  name             String
  description      String?
  categoryId       Int?
  companyId        Int?
  createdById      Int?
  source           HuntPlaceSource      @default(USER_SUGGESTED)
  address          String?
  city             String?
  district         String?
  latitude         Decimal?             @db.Decimal(10, 7)
  longitude        Decimal?             @db.Decimal(10, 7)
  geohash          String?
  tags             String[]             @default([])
  postCount        Int                  @default(0)
  likeCount        Int                  @default(0)
  wantedCount      Int                  @default(0)
  isActive         Boolean              @default(true)
  isClaimable      Boolean              @default(true)
  moderationStatus HuntModerationStatus @default(CLEAR)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  category  Category?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  company   Company?   @relation(fields: [companyId], references: [id], onDelete: SetNull)
  createdBy User?      @relation("HuntPlaceCreator", fields: [createdById], references: [id], onDelete: SetNull)
  posts     HuntPost[]

  @@index([categoryId, isActive])
  @@index([companyId])
  @@index([createdById])
  @@index([city, district])
  @@index([geohash])
  @@index([moderationStatus, createdAt])
}

model HuntPost {
  id               String               @id @default(cuid())
  uuid             String               @unique @default(uuid())
  userId           Int
  placeId          String
  categoryId       Int?
  companyId        Int?
  caption          String               @db.Text
  photoUrl         String?
  mediaUrls        String[]             @default([])
  tags             String[]             @default([])
  rating           Int?
  visitPriceBand   String?
  moodTags         String[]             @default([])
  latitude         Decimal?             @db.Decimal(10, 7)
  longitude        Decimal?             @db.Decimal(10, 7)
  locationAccuracy Int?
  gpsConfidence    Int                  @default(0)
  status           HuntPostStatus       @default(PUBLISHED)
  moderationStatus HuntModerationStatus @default(CLEAR)
  likeCount        Int                  @default(0)
  score            Int                  @default(0)
  influenceAwarded Int                  @default(0)
  firstTrendingAt  DateTime?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  place     HuntPlace          @relation(fields: [placeId], references: [id], onDelete: Cascade)
  category  Category?          @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  company   Company?           @relation(fields: [companyId], references: [id], onDelete: SetNull)
  reactions HuntPostReaction[]
  reports   HuntPostReport[]
  boxes     HuntBox[]          @relation("HuntBoxSourcePost")

  @@index([userId, createdAt])
  @@index([placeId, createdAt])
  @@index([categoryId, createdAt])
  @@index([companyId, createdAt])
  @@index([status, moderationStatus, score, createdAt])
  @@index([moderationStatus, updatedAt])
}

model HuntPostReaction {
  id        String           @id @default(cuid())
  postId    String
  userId    Int
  type      HuntReactionType @default(LIKE)
  createdAt DateTime         @default(now())

  post HuntPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId, type])
  @@index([userId, createdAt])
  @@index([postId, createdAt])
}

model HuntPostReport {
  id          String               @id @default(cuid())
  uuid        String               @unique @default(uuid())
  postId      String
  reporterId  Int
  reason      HuntReportReason
  details     String?              @db.Text
  status      HuntReportStatus     @default(OPEN)
  moderatorId Int?
  resolvedAt  DateTime?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  post      HuntPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  reporter  User     @relation("HuntPostReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  moderator User?    @relation("HuntPostReportModerator", fields: [moderatorId], references: [id], onDelete: SetNull)

  @@unique([postId, reporterId])
  @@index([postId, status])
  @@index([reporterId, createdAt])
  @@index([status, createdAt])
  @@index([moderatorId])
}

model HuntCurrencyLedger {
  id           String             @id @default(cuid())
  uuid         String             @unique @default(uuid())
  userId       Int
  amount       Int
  reason       HuntCurrencyReason
  sourceType   String?
  sourceId     String?
  balanceAfter Int
  metadata     Json?
  createdAt    DateTime           @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([reason, createdAt])
  @@index([sourceType, sourceId])
}

model HuntCreatureSpecies {
  id           String         @id @default(cuid())
  slug         String         @unique
  name         String
  description  String         @db.Text
  element      HuntElement
  baseRarity   HuntCardRarity @default(COMMON)
  categoryId   Int?
  baseStats    Json
  traitPool    Json
  visualPrompt String         @db.Text
  imageUrl     String?
  isActive     Boolean        @default(true)
  sortOrder    Int            @default(0)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  category Category?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  cards    HuntCard[]

  @@index([element, baseRarity, isActive])
  @@index([categoryId])
}

model HuntBox {
  id            String         @id @default(cuid())
  uuid          String         @unique @default(uuid())
  userId        Int
  type          HuntBoxType
  rarity        HuntCardRarity @default(COMMON)
  status        HuntBoxStatus  @default(GRANTED)
  influenceCost Int            @default(0)
  sourcePostId  String?
  rewardCardId  String?        @unique
  expiresAt     DateTime?
  openedAt      DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourcePost HuntPost? @relation("HuntBoxSourcePost", fields: [sourcePostId], references: [id], onDelete: SetNull)
  rewardCard HuntCard? @relation("HuntBoxRewardCard", fields: [rewardCardId], references: [id], onDelete: SetNull)

  @@index([userId, status, createdAt])
  @@index([type, rarity])
  @@index([sourcePostId])
}

model HuntCard {
  id         String         @id @default(cuid())
  uuid       String         @unique @default(uuid())
  ownerId    Int
  speciesId  String
  rarity     HuntCardRarity
  element    HuntElement
  level      Int            @default(1)
  xp         Int            @default(0)
  stats      Json
  trait      String
  visualSeed String
  isLocked   Boolean        @default(false)
  sourceBox  HuntBox?       @relation("HuntBoxRewardCard")
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  owner   User                @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  species HuntCreatureSpecies @relation(fields: [speciesId], references: [id], onDelete: Restrict)
  upgrades HuntCardUpgrade[]

  @@index([ownerId, rarity, createdAt])
  @@index([speciesId])
  @@index([element, rarity])
}

model HuntCardUpgrade {
  id             String                @id @default(cuid())
  uuid           String                @unique @default(uuid())
  userId         Int
  cardId         String
  levelFrom      Int
  levelTo        Int
  cost           Int
  statsBefore    Json
  baseDeltas     Json
  statsAfterBase Json
  bonusStat      String?
  bonusDelta     Int?
  statsAfterBonus Json?
  status         HuntCardUpgradeStatus @default(PENDING_BONUS)
  createdAt      DateTime              @default(now())
  bonusAppliedAt DateTime?

  user User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  card HuntCard @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@index([userId, status, createdAt])
  @@index([cardId, createdAt])
}

model HuntMission {
  id              String          @id @default(cuid())
  slug            String          @unique
  title           String
  description     String          @db.Text
  kind            HuntMissionKind
  targetAction    String
  targetCount     Int             @default(1)
  rewardInfluence Int             @default(0)
  rewardXp        Int             @default(0)
  rewardBoxType   HuntBoxType?
  isActive        Boolean         @default(true)
  startsAt        DateTime?
  endsAt          DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  progress HuntMissionProgress[]

  @@index([kind, isActive])
  @@index([startsAt, endsAt])
}

model HuntMissionProgress {
  id          String    @id @default(cuid())
  userId      Int
  missionId   String
  progress    Int       @default(0)
  completedAt DateTime?
  claimedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  mission HuntMission @relation(fields: [missionId], references: [id], onDelete: Cascade)

  @@unique([userId, missionId])
  @@index([userId, completedAt, claimedAt])
  @@index([missionId])
}
